# live-record server configuration. Copy to .env and fill in; the server refuses to start without the required ones.

# --- required ---
RECORDINGS_DIR=/path/to/recordings            # uploaded audio, chunks/<device>/<date>/<HH>.<ext> (pieces appended per hour)
LIVE_DATA=/path/to/live-record-data           # live.db (all state), <date>.passes.jsonl (engine trace), owner-redimnet2.npz, voices/clips/
VAD_MODEL_DIR=/path/to/FireRedVAD/Stream-VAD  # FireRedVAD streaming checkpoint directory
ASR_UPLOAD_BRIDGE_URL=https://example.com/upload   # POST {filename, content_type} -> {upload_url, download_url}
ASR_UPLOAD_BRIDGE_TOKEN=
ASR_SERVICE_URL=https://example.com/v1        # file-mode ASR with speakers and word times: POST /audio/transcriptions {audio_url, model}, GET /jobs/{id}
ASR_SERVICE_BASIC_AUTH=user:password

# --- optional ---
PORT=8770
HOST=127.0.0.1           # 0.0.0.0 when a reverse proxy on another machine fronts the server
AUTH_TOKEN=              # required when exposed: open any page once with ?token=<AUTH_TOKEN>, a year-long cookie does the rest
FILE_MODELS=stepaudio-2.5-asr-8006,doubao-seedasr-2.0   # file-mode engines in order; the second takes windows the first refuses
REFINE_EVERY_S=20         # draft layer (a page watching): a pass after this long without a pause
ENGINE=volc               # second-layer engine: volc (Volcengine seed-asr-2.0 streaming API, needs VOLC_ASR_KEY) | stepfun (file-mode service)
VOLC_ASR_KEY=             # Volcengine Ark Agent Plan API key
TURN_GAP_S=0              # >0 merges a speaker's neighbouring sentences closer than this into one row
OWNER_LABELS=             # owner.py only: jsonl of windows known to be the owner's voice
CASES_DIR=                # eval_all.sh only: directory of ground-truth cases
# replay_case.py / service_case.py only: STEPFUN_API_KEY, STEPFUN_SSE_URL, EMB_MODEL (CAM++ onnx), SEG_MODEL, OWNER_SURE, LINK_MIN, OWNER_DEFAULT_DEVICE

# --- conversation summaries (required) ---
LLM_BASE_URL=https://example.com/v1   # OpenAI-compatible; POST /chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# live-record server configuration. Copy to .env and fill in; the server refuses to start without the required ones.

# --- required ---
RECORDINGS_DIR=/path/to/recordings            # the recorder's 30-minute Opus files (YYYY-MM-DD_HH-MM-SS.ogg + .json sidecar), and the webm streams the /record page uploads
LIVE_DATA=/path/to/live-record-data           # output: <date>.jsonl, <date>.final.jsonl, <date>.conversations.jsonl, owner.npz
VAD_MODEL_DIR=/path/to/FireRedVAD/Stream-VAD  # FireRedVAD streaming checkpoint directory
EMB_MODEL=/path/to/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx   # sherpa-onnx speaker embedding model
ASR_UPLOAD_BRIDGE_URL=https://example.com/upload   # POST {filename, content_type} -> {upload_url, download_url}
ASR_UPLOAD_BRIDGE_TOKEN=
ASR_SERVICE_URL=https://example.com/v1        # file-mode ASR with speakers and word times: POST /audio/transcriptions {audio_url, model}, GET /jobs/{id}
ASR_SERVICE_BASIC_AUTH=user:password

# --- optional ---
PORT=8770
HOST=127.0.0.1           # 0.0.0.0 when a reverse proxy on another machine fronts the server
AUTH_TOKEN=              # required when exposed: open any page once with ?token=<AUTH_TOKEN>, a year-long cookie does the rest
DIARIZER=cloud            # cloud: speakers from the file-mode ASR result | local: sherpa-onnx on this machine (needs SEG_MODEL)
SEG_MODEL=                # sherpa-onnx pyannote-segmentation-3.0 model.onnx, only for DIARIZER=local
FIRST_LAYER=off           # on: per-utterance streaming ASR for a fast pending row (needs STEPFUN_API_KEY and STEPFUN_SSE_URL)
TEXT_SOURCE=file          # local diarizer's text: file (one file-mode call per pass) | sse (one call per turn)
STEPFUN_API_KEY=
STEPFUN_SSE_URL=
FILE_MODELS=stepaudio-2.5-asr-8006,doubao-seedasr-2.0   # file-mode engines in order; the second takes windows the first refuses
REFINE_EVERY_S=20         # finalization cadence
TURN_GAP_S=0              # >0 merges a speaker's neighbouring sentences closer than this into one row
OWNER_SURE=0.5            # a cluster this close to the owner voiceprint is the owner
LINK_MIN=0.55             # cosine to link a window's cluster to a known speaker of the conversation
OWNER_DEFAULT_DEVICE=     # device whose owner voiceprint scores recordings from devices owner.py has not seen (e.g. a phone)
OWNER_LABELS=             # owner.py only: jsonl of windows known to be the owner's voice
CASES_DIR=                # eval_all.sh only: directory of ground-truth cases
